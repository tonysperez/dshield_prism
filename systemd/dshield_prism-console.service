[Unit]
Description=DShield Prism console — read-only investigation web UI (FastAPI/uvicorn)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=dshield_prism
Group=dshield_prism
WorkingDirectory=/opt/dshield_prism/console
EnvironmentFile=/opt/dshield_prism/.env

# Owning-unit stamp for pipeline telemetry. `enrich.ops.run_start` copies this
# onto every `prism.ops` verb_run doc the unit's steps write, so the console's
# /health "Pipeline & schedule" panel groups runs by unit. `%n` expands to this
# unit's full name — no per-file hardcoding and no console-side unit->verb map
# to drift. Set AFTER the EnvironmentFile so it wins.
Environment=PRISM_SYSTEMD_UNIT=%n
# Release-readiness P1-5: the installed source tree is read-only
# (ProtectSystem=strict below), so command_grounding's denylist read/write
# path resolves under this unit's ReadWritePaths instead of the package dir.
# Must match every other unit that touches command_grounding (this console
# unit + all pipeline units) or the console's denylist edits split-brain from
# what the pipeline actually reads. hunts.config_dir (config/default.yaml)
# points at the same ReadWritePaths root for the same reason.
Environment=PRISM_STATE_DIR=/var/lib/dshield_prism

# Binds 127.0.0.1:8765 (loopback) by default. The console ships with NO
# built-in authentication, so it must not face the LAN directly. To serve
# analysts on the LAN, put it behind a reverse proxy that terminates auth on
# the LAN interface and forwards to this loopback port — see
# docs/operations.md ("Exposing the console on the LAN"). Do NOT edit this
# file; override via a drop-in at
# /etc/systemd/system/dshield_prism-console.service.d/override.conf so the
# change survives reinstall.
ExecStart=/opt/dshield_prism/console/.venv/bin/python -m console.cli serve --host 127.0.0.1 --port 8765 --config /opt/dshield_prism/config/default.yaml

Restart=on-failure
RestartSec=5s

StandardOutput=journal
StandardError=journal

# Hardening
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/dshield_prism /var/log/dshield_prism
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
