[Unit]
Description=DShield Prism weekly full assignment sweep + novel-pool session mint + full IP re-cluster (Option A cutover / backlog B0.5)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=dshield_prism
Group=dshield_prism
WorkingDirectory=/opt/dshield_prism
EnvironmentFile=/opt/dshield_prism/.env

# Unlike every sibling unit (backward=6h, forward/analytics/grounding-coverage=2h),
# this unit had no ceiling — review flagged it twice as a gap once the combined
# mint+name ExecStart (below) could both run longer (full-corpus naming backlog)
# AND block indefinitely on lock contention. 6h matches backward.service's budget
# for a chain that also does LLM naming + escalate; this unit fires weekly so a
# long run has no self-collision risk.
TimeoutStartSec=6h

# Owning-unit stamp for pipeline telemetry. `enrich.ops.run_start` copies this
# onto every `prism.ops` verb_run doc the unit's steps write, so the console's
# /health "Pipeline & schedule" panel groups runs by unit. `%n` expands to this
# unit's full name — no per-file hardcoding and no console-side unit->verb map
# to drift. Set AFTER the EnvironmentFile so it wins.
Environment=PRISM_SYSTEMD_UNIT=%n

# Post-Option-A-cutover this weekly unit does four things:
#   * SESSIONS (assign): a single all-time `assign_sessions --window-days 0` — sweeps
#     every session (not just the 6h backward pass's trailing 30d) against the current
#     anchor set. Without this, any session older than 30 days at the time it first
#     becomes eligible (a corpus reprocess/backfill, a slow-drip backlog, a sensor
#     catching up after downtime) sits permanently unassigned: no scheduled job ever
#     revisits it, since the 6h pass is windowed and this unit used to only cluster the
#     novel pool, never re-sweep assignment. Found the hard way: a full reprocess left
#     633K rollups with only ~8.5K command-bearing/eligible, and roughly half of THOSE
#     sat unassigned indefinitely because nothing unwindowed ever ran assign_sessions.
#   * SESSIONS (mint + name): `cluster sessions --novel-pool` — HDBSCAN over the FULL
#     novel pool (whatever the assign sweep above just marked novel), so older novel
#     sessions that never got an anchor finally do — followed by `name playbooks` in
#     the SAME flock hold (item 58, clustering-quality investigation Finding 44). The
#     6h backward chain only ever names clusters from ITS OWN 30-day-windowed
#     `cluster sessions` step; it never sees this unit's full-corpus mint, so 83.8% of
#     the novel pool was permanently unnamed by construction. Naming must run here,
#     right after the mint. It is combined into ONE `ExecStart` (`mint && { name ||
#     true; }`) rather than two separate lines: `flock` is acquired/released per
#     `ExecStart=` line, not held for the unit's duration, so two lines would leave a
#     gap where the 6h chain's own windowed mint+name pair could interleave, overwrite
#     "latest run_summary", and make this unit name the WRONG (windowed) run —
#     silently reproducing item 58. One flock spanning both commands closes that: any
#     other unit's flock'd step blocks (no `-n`) until this line's shell fully exits.
#     Mint keeps hard-fail semantics (`&&` short-circuits on mint failure, aborting
#     the unit before IP work, unchanged from before); naming's failure is swallowed
#     (`|| true`) so it never blocks the IP work below — the CLI verb still records
#     its own failure to `prism.ops`. `run_name_playbooks` already skips already-named
#     clusters, so repeat invocation (6h + weekly) is safe and cheap. Local LLM only,
#     never cloud.
#   * IPS: the full O(n^2) IP HDBSCAN + `--refresh-reference` (unchanged by the session
#     cutover) — the only periodic full IP fit + IP reference refresh (backlog B0.5).
# Identity is preserved: playbook ids re-match by centroid anchor, so this does not churn
# spb- ids or playbook names.

# Mutex with forward/backward — flock blocks (no -n) so this waits for an
# in-flight pass rather than colliding on the cache / cluster index.
ExecStartPre=/usr/bin/flock /var/lib/dshield_prism/.lock /bin/true

# Full-corpus assignment sweep, `-` (soft) so a slow/failed pass never blocks the
# novel-pool mint or IP work below — failure surfaces in prism.ops. `--allow-unclassified`
# is REQUIRED: assignment must cover every session regardless of classification (a
# server-side label write, no egress — same posture as `cluster sessions`). Runs BEFORE
# the novel-pool mint below so a session an existing anchor can now claim doesn't get
# re-clustered into a duplicate playbook.
ExecStart=-/usr/bin/flock /var/lib/dshield_prism/.lock /opt/dshield_prism/.venv/bin/python /opt/dshield_prism/scripts/assign_sessions.py --config /opt/dshield_prism/config/default.yaml --window-days 0 --apply --yes --allow-unclassified

# Option A cutover: `--novel-pool` scopes this to sessions the authoritative assignment
# runner marked novel; `--window-days 0` forces the FULL all-time novel pool (the 6h
# backward pass only mints from the last 30d of novel, so this catches older novel
# sessions that never got an anchor). Self-converges with the full assign sweep above:
# this pass's freshly-minted anchors get swept into the assigned bulk next week.
# `--refresh-reference` is dropped on the session layer: post-cutover, session novelty is
# assignment-owned (below-τ / band-reject), not reference-centroid-scored, and re-minting
# the reference from the novel pool only would mis-calibrate it. If you REVERSE the
# cutover, restore `cluster sessions --window-days 0 --refresh-reference` here.
ExecStart=/usr/bin/flock /var/lib/dshield_prism/.lock /bin/sh -c '/opt/dshield_prism/.venv/bin/python -m enrich.cli --config /opt/dshield_prism/config/default.yaml cluster sessions --novel-pool --window-days 0 && { /opt/dshield_prism/.venv/bin/python -m enrich.cli --config /opt/dshield_prism/config/default.yaml name playbooks || true; }'

# Backlog scale-hardening B0.5 — the IP layer has no windowing escape valve, so
# its full O(n^2) HDBSCAN is the dominant scale wall (~23 min at 50K embedded
# IPs; eval/results/B0-preflight-loadtest.md). When ip.full_recluster_weekly is
# set, the 6-hourly backward `cluster ips` skips and this weekly pass is the
# only full IP fit. `--window-days 0` forces the full run regardless of the
# flag; `--refresh-reference` re-mints the IP reference_centroid set — which the
# 6h chain never did, so without this the IP reference only ever bootstraps and
# ages past ip.reference_max_age_days. Beneficial even with the flag off (gives
# the IP reference its only periodic refresh). `-` (soft) so a slow/failed full
# IP pass never blocks prune-clusters below — the failure still surfaces in
# prism.ops.
ExecStart=-/usr/bin/flock /var/lib/dshield_prism/.lock /opt/dshield_prism/.venv/bin/python -m enrich.cli --config /opt/dshield_prism/config/default.yaml cluster ips --window-days 0 --refresh-reference

# Cap the cluster index after the full run appends a fresh (larger) centroid
# set + run_summary — keeps the newest K runs, preserves every
# reference_centroid generation (P2.1).
ExecStart=-/usr/bin/flock /var/lib/dshield_prism/.lock /opt/dshield_prism/.venv/bin/python -m enrich.cli --config /opt/dshield_prism/config/default.yaml prune-clusters

# Retire anchors no session points at any more. Assignment + novel-pool minting
# leave behind dead anchors (sessions migrate to a nearer/confirmed twin), which
# the consolidation engine can't reach (0 sessions → no TF-IDF centroid → it
# won't blind-merge them). `--window-days 0` = all-time, so only TRULY dead
# anchors retire — a behavior dormant some weeks still has all-time sessions and
# is kept (seasonal-safe). Runs AFTER the novel-pool mint above, so freshly
# minted anchors (which carry their own cluster's sessions) are never caught.
# Reversible (`prune_inactive_anchors.py --unretire`). `-` (soft) so a prune
# hiccup never blocks the timer; failure surfaces in prism.ops.
# `--allow-unclassified` so the inactivity count covers every sensor (an anchor
# active only in confidential data is NOT dead).
ExecStart=-/usr/bin/flock /var/lib/dshield_prism/.lock /opt/dshield_prism/.venv/bin/python /opt/dshield_prism/scripts/prune_inactive_anchors.py --config /opt/dshield_prism/config/default.yaml --window-days 0 --apply --yes --allow-unclassified
