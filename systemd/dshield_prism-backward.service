# NOTE: four daily write-leaves — intel refresh, apply-artifact-rules,
# track threshold-distributions, mine file-crossref — were split out of this
# chain into dshield_prism-analytics.service (daily 04:15). Nothing in the
# pipeline reads their output same-cycle. `escalate` stayed: it reads
# this-cycle clustering novelty, so its cadence must equal the model's.
[Unit]
Description=DShield Prism backward pass — re-embed, re-enrich-stale, re-cluster, re-escalate, re-mine
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=dshield_prism
Group=dshield_prism
WorkingDirectory=/opt/dshield_prism
EnvironmentFile=/opt/dshield_prism/.env

# Owning-unit stamp for pipeline telemetry. `enrich.ops.run_start` copies this
# onto every `prism.ops` verb_run doc the unit's steps write, so the console's
# /health "Pipeline & schedule" panel groups runs by unit. `%n` expands to this
# unit's full name — no per-file hardcoding and no console-side unit->verb map
# to drift. Set AFTER the EnvironmentFile so it wins.
Environment=PRISM_SYSTEMD_UNIT=%n
# Release-readiness P1-5: the installed source tree is read-only
# (ProtectSystem=strict below), so command_grounding's denylist read/write
# path resolves under this unit's ReadWritePaths instead of the package dir.
# Must match every other unit that touches command_grounding (console + all
# pipeline units) or the console's denylist edits split-brain from what the
# pipeline actually reads.
Environment=PRISM_STATE_DIR=/var/lib/dshield_prism

# Mutex with the forward pass. flock blocks (no -n) so the backward task
# waits for an in-flight forward run rather than colliding on the cache.
ExecStartPre=/usr/bin/flock /var/lib/dshield_prism/.lock /bin/true

# Soft-warn on local LLM unreachable — most backward steps don't need
# the LLM (cluster / escalate / mine campaigns). `reembed`,
# `re-enrich-stale`, and `name playbooks` do, and will fail individually
# with `-` ExecStart prefixes if the LLM is down. `-` on the healthcheck
# = unit continues even when LLM is unreachable.
ExecStartPre=-/opt/dshield_prism/.venv/bin/python -m enrich.cli --config /opt/dshield_prism/config/default.yaml healthcheck --scope llm

# --- Step 1: re-enrich rows whose LLM hash drifted (prompt edits etc.).
# Smart-skip when nothing has changed — near-zero cost in steady state.
# Optional: failures here shouldn't stop the chain.
ExecStart=-/usr/bin/flock /var/lib/dshield_prism/.lock /opt/dshield_prism/.venv/bin/python -m enrich.cli --config /opt/dshield_prism/config/default.yaml re-enrich-stale

# --- Step 2: re-embed rows whose embed hash drifted (embed_context /
# embedding_model / embed_cooccurrence changes). Smart-skip when fresh.
ExecStart=-/usr/bin/flock /var/lib/dshield_prism/.lock /opt/dshield_prism/.venv/bin/python -m enrich.cli --config /opt/dshield_prism/config/default.yaml reembed

# --- Step 3: conditionally invalidate the session + IP rollup watermarks so
# the next rollup pass re-pools to absorb fresh command embeddings — but ONLY
# when steps 1-2 actually rewrote a command doc (dirty flag) or the rollup
# builder changed (schema hash). In steady state nothing changed, so this is a
# no-op and `rollup sessions/ips` below stay incremental instead of re-pooling
# the whole corpus every 6h (P1.1). `--if-stale` is the gate; SQLite-only.
ExecStart=-/usr/bin/flock /var/lib/dshield_prism/.lock /opt/dshield_prism/.venv/bin/python -m enrich.cli --config /opt/dshield_prism/config/default.yaml reset --if-stale --yes

# --- Step 4: re-roll sessions and IPs with the refreshed embeddings.
ExecStart=-/usr/bin/flock /var/lib/dshield_prism/.lock /opt/dshield_prism/.venv/bin/python -m enrich.cli --config /opt/dshield_prism/config/default.yaml rollup sessions
ExecStart=-/usr/bin/flock /var/lib/dshield_prism/.lock /opt/dshield_prism/.venv/bin/python -m enrich.cli --config /opt/dshield_prism/config/default.yaml rollup ips

# --- Step 5: re-cluster every layer. Always recomputes from current
# embeddings — that's what makes novelty scores reflect the current corpus.
# cluster commands is required (every downstream step depends on its
# novelty output); sessions/ips are `-` so a transient failure logs but
# doesn't abort the chain.
# `cluster sessions` honours session.cluster_window_days (default 30), so this
# 6h pass windows to the last 30 days of sessions (P1.2) instead of the whole
# rollup. The weekly `dshield_prism-recluster-full` timer does the full
# `--window-days 0 --refresh-reference` pass that refreshes the reference and
# re-pools the long tail.
ExecStart=/usr/bin/flock /var/lib/dshield_prism/.lock /opt/dshield_prism/.venv/bin/python -m enrich.cli --config /opt/dshield_prism/config/default.yaml cluster commands

# --- Step 5a: self-heal the external reference baseline (console "Tradecraft
# Matches") with LOCAL steps only — runs BEFORE `cluster sessions` so freshly
# minted external centroids are scored against live sessions this same cycle.
# State-gated + idempotent (cheap no-op when healthy); never clones GitHub
# (the import stays a setup/manual step). `-` so it never blocks the chain.
ExecStart=-/usr/bin/flock /var/lib/dshield_prism/.lock /opt/dshield_prism/.venv/bin/python -m enrich.cli --config /opt/dshield_prism/config/default.yaml reference-heal

# --- Step 5 (Option A cutover): authoritative session assignment, then novel-pool
# minting. `assign_sessions` is the labeller for the KNOWN bulk — it writes playbook_id
# by nearest anchor (+ TF-IDF band confirm) and clears it on the novel tail
# (cluster.assignment_status=novel). `--allow-unclassified` is REQUIRED here: the pipeline
# must label every session regardless of classification (a server-side label write, no
# egress — same posture as the old `cluster sessions`). `cluster sessions --novel-pool`
# then runs HDBSCAN over ONLY the novel tail to mint new-behaviour anchors (named by
# step 7), instead of re-clustering — and overwriting — the assigned bulk. Self-converges:
# next pass `assign_sessions` flips last pass's newly-minted sessions out of the novel pool.
# NOTE: this step is windowed to the trailing 30 days — a session outside the window when
# it first becomes eligible (corpus reprocess/backfill, a sensor catching up after
# downtime) is NOT revisited here. `dshield_prism-recluster-full.service` (weekly) runs
# the unwindowed `assign_sessions --window-days 0` sweep that catches those.
# Gated by session.assignment_authoritative (true). REVERSE the cutover: set it false and
# restore a plain `cluster sessions` here (and in recluster-full.service). The weekly
# `dshield_prism-recluster-full.service` is also scoped to `--novel-pool` for the cutover,
# so it no longer re-labels the assigned bulk.
ExecStart=-/usr/bin/flock /var/lib/dshield_prism/.lock /opt/dshield_prism/.venv/bin/python /opt/dshield_prism/scripts/assign_sessions.py --config /opt/dshield_prism/config/default.yaml --window-days 30 --apply --yes --allow-unclassified
ExecStart=-/usr/bin/flock /var/lib/dshield_prism/.lock /opt/dshield_prism/.venv/bin/python -m enrich.cli --config /opt/dshield_prism/config/default.yaml cluster sessions --novel-pool --window-days 30
# `cluster ips` self-gates on ip.full_recluster_weekly (backlog B0.5): with the
# default (false) it runs the full IP HDBSCAN here every cycle (legacy); set it
# true for the multi-sensor backlog and this runs the cheap incremental
# nearest-centroid assign instead (run_assign — new IPs only, no HDBSCAN) while
# the full O(n^2) IP fit moves to the weekly recluster-full timer (no IP window).
ExecStart=-/usr/bin/flock /var/lib/dshield_prism/.lock /opt/dshield_prism/.venv/bin/python -m enrich.cli --config /opt/dshield_prism/config/default.yaml cluster ips

# --- Step 5b: cap the cluster indices. Each cluster run appends a fresh
# centroid set + run_summary and never prunes; only the latest run is ever
# read. Keep the newest few runs per layer, delete the dead rest. Every
# reference_centroid generation is preserved (cross-run novelty anchors).
# Runs after all clustering so the newest run is always retained. Soft-fail —
# a prune hiccup must never abort the chain. Scale-hardening P2.1.
ExecStart=-/usr/bin/flock /var/lib/dshield_prism/.lock /opt/dshield_prism/.venv/bin/python -m enrich.cli --config /opt/dshield_prism/config/default.yaml prune-clusters

# --- Step 6: cloud escalation re-runs against the freshly-clustered
# novelty scores. May skip everything if daily budget is exhausted —
# `-` is fine because the local-only enrichments stay in place.
ExecStart=-/usr/bin/flock /var/lib/dshield_prism/.lock /opt/dshield_prism/.venv/bin/python -m enrich.cli --config /opt/dshield_prism/config/default.yaml escalate

# --- Step 7: name new session clusters. Skips already-named clusters
# automatically (no --force) — only new clusters get an LLM call.
ExecStart=-/usr/bin/flock /var/lib/dshield_prism/.lock /opt/dshield_prism/.venv/bin/python -m enrich.cli --config /opt/dshield_prism/config/default.yaml name playbooks

# --- Step 7b: annotate IP-cluster centroids with their dominant playbook
# now that session.playbook_id has been filled in by step 7. No LLM
# calls — just a join over session rollups. ROADMAP #24.
ExecStart=-/usr/bin/flock /var/lib/dshield_prism/.lock /opt/dshield_prism/.venv/bin/python -m enrich.cli --config /opt/dshield_prism/config/default.yaml name ip-clusters

# --- Step 8: mine multi-session campaigns over the refreshed playbook
# set. Stable campaign IDs (content-hashed playbook set, ROADMAP #2).
ExecStart=-/usr/bin/flock /var/lib/dshield_prism/.lock /opt/dshield_prism/.venv/bin/python -m enrich.cli --config /opt/dshield_prism/config/default.yaml mine campaigns --kind all

# --- Step 8a: promote (bhv × inf) campaign pairs whose IP overlap clears
# the corpus-p75 percentile to first-class operation docs in
# `prism.operations` with stable `op-<16hex>` ids content-addressed on
# the pair. Same signal as the `campaign_convergence` finding kind, but
# persisted as an entity for the graph anchor type (7.2) and the
# `operation_emergence` finding kind (7.3). Soft-fail. Brutal-review 7.1.
ExecStart=-/usr/bin/flock /var/lib/dshield_prism/.lock /opt/dshield_prism/.venv/bin/python -m enrich.cli --config /opt/dshield_prism/config/default.yaml mine operations

# --- Step 8b: append this-run snapshots to the lifecycle indices
# (playbook / campaign / source_ip) and bump silent_runs_current on
# artifacts not seen this run. Findings v2 step 1 — feeds drift detectors
# (Findings v2 step 4) once anchors are populated.
ExecStart=-/usr/bin/flock /var/lib/dshield_prism/.lock /opt/dshield_prism/.venv/bin/python -m enrich.cli --config /opt/dshield_prism/config/default.yaml track lifecycles

# --- Step 10: mine findings. Inlined into the backward chain (formerly
# hourly via dshield_prism-mine-findings.timer) so it always runs AFTER
# `name playbooks` and `track lifecycles` — without this ordering, the
# miner can fire in a window where playbook_id has not yet been stamped
# onto session_clusters, which produced run-scoped fallback findings
# that orphaned on the next pass and accumulated forever.
# The mine-findings timer is now disabled by `setup.sh`; this is the
# canonical schedule.
ExecStart=-/usr/bin/flock /var/lib/dshield_prism/.lock /opt/dshield_prism/.venv/bin/python -m enrich.cli --config /opt/dshield_prism/config/default.yaml mine findings

# --- Step 13: run hypothesis-driven hunts. Loads YAML from
# `cfg.findings.hunts.config_dir` (default: config/hunts), executes each
# hunt's filters against the session rollup, and writes one
# `kind=analyst_hunt` finding per matching session. Runs AFTER step 10
# (`mine findings`) so the lifecycle / playbook fields the hunts read
# are populated. Soft-fail; a malformed hunt YAML shouldn't abort the
# backward chain. Brutal-review phase 6.1.
ExecStart=-/usr/bin/flock /var/lib/dshield_prism/.lock /opt/dshield_prism/.venv/bin/python -m enrich.cli --config /opt/dshield_prism/config/default.yaml mine hunts

StandardOutput=journal
StandardError=journal

# 6h ceiling — backward pass has up to 8 sequential steps, several with
# bulk ES writes and LLM calls. Plenty of headroom for a growing corpus.
TimeoutStartSec=6h
Nice=10

# Hardening
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/dshield_prism /var/log/dshield_prism
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
