# Per-deploy / secret config — never commit
.env
config/local.yaml
*.bak

# Python
pyvenv.cfg
bin/
__pycache__/
*.py[cod]
*.egg-info/
.venv/
build/
dist/

# Worker state
*.sqlite
*.sqlite-wal
*.sqlite-shm
.ruff_cache

# Eval: generated output, never committed (rebuildable from the corpus + scripts).
# Curated methodology (README, RUBRIC, labeling prompt, baselines) stays tracked;
# the results/ dir is kept (via .gitkeep) so scripts have a write target.
eval/archive
eval/results/*
!eval/results/.gitkeep
eval/sessions/
# Per-session renders from render_eval_set.py — generated, never tracked
# (same class as eval/sessions/, just an older generation's output dir).
eval/sessions-v1/
eval/confidential/
eval/discovery-stall-history.jsonl

# Second-pass label files (agreement inputs). Never committed: `labels.yaml` is
# the deliverable, and a committed second pass is readable by the next
# annotator, which destroys the blindness the measurement depends on.
eval/labels-relabel*.yaml
eval/labels-secondary.yaml
# Held-out human slice for scoring an LLM labelling pass. Same reason as the
# files above: committing it lets the next annotator read it, which destroys the
# blindness the agreement number depends on.
eval/labels-heldout*.yaml

# Agentic development
.claude
.codex

# Spec-driven development
_bmad
_bmad-output
.agents