# Per-deploy / secret config — never commit
.env
config/local.yaml

# Python
pyvenv.cfg
bin/
__pycache__/
*.py[cod]
*.egg-info/
.venv/
build/
dist/

# Worker state
*.sqlite
*.sqlite-wal
*.sqlite-shm

# Claude
.claude

.ruff_cache

# Eval: generated output, never committed (rebuildable from the corpus + scripts).
# Curated methodology (README, RUBRIC, labeling prompt, baselines) stays tracked;
# the results/ dir is kept (via .gitkeep) so scripts have a write target.
eval/archive
eval/results/*
!eval/results/.gitkeep
eval/sessions-v1/
eval/confidential/