{
  "_comment": "Session-level rollup. One doc per cowrie session_id. Doc _id = session_id (idempotent upserts). Built by 'rollup-sessions'; cluster fields populated by 'cluster-sessions'.",
  "settings": {
    "number_of_shards": 1,
    "number_of_replicas": 0,
    "refresh_interval": "30s"
  },
  "mappings": {
    "properties": {
      "@timestamp": { "type": "date" },

      "event": {
        "properties": {
          "kind":     { "type": "keyword" },
          "category": { "type": "keyword" },
          "dataset":  { "type": "keyword" },
          "start":    { "type": "date" },
          "end":      { "type": "date" },
          "duration": { "type": "long" }
        }
      },

      "source": {
        "properties": {
          "ip":   { "type": "ip" },
          "port": { "type": "integer" },
          "geo": {
            "properties": {
              "city_name":        { "type": "keyword" },
              "country_iso_code": { "type": "keyword" },
              "region_name":      { "type": "keyword" },
              "location":         { "type": "geo_point" }
            }
          },
          "as": {
            "properties": {
              "number": { "type": "long" },
              "organization": {
                "properties": { "name": { "type": "keyword" } }
              }
            }
          }
        }
      },

      "destination": {
        "properties": {
          "ip":   { "type": "ip" },
          "port": { "type": "integer" }
        }
      },

      "network": {
        "properties": {
          "protocol": { "type": "keyword" },
          "type":     { "type": "keyword" }
        }
      },

      "user": {
        "properties": { "name": { "type": "keyword" } }
      },

      "user_agent": {
        "properties": { "original": { "type": "keyword" } }
      },

      "cowrie": {
        "properties": {
          "session_id":       { "type": "keyword" },
          "password":         { "type": "keyword" },
          "hassh_algorithms": { "type": "keyword" },
          "hassh":            { "type": "text", "fields": { "keyword": { "type": "keyword", "ignore_above": 64 } } }
        }
      },

      "threat": {
        "properties": {
          "indicator": {
            "type": "nested",
            "properties": {
              "type":   { "type": "keyword" },
              "ip":     { "type": "ip" },
              "domain": { "type": "keyword" },
              "url":    { "properties": { "full": { "type": "keyword" } } },
              "file": {
                "properties": {
                  "name": { "type": "keyword" },
                  "hash": { "properties": { "sha256": { "type": "keyword" } } }
                }
              }
            }
          }
        }
      },

      "dshield": {
        "properties": {
          "cowrie": {
            "properties": {
              "enrichment": {
                "properties": {
                  "session": {
                    "properties": {
                      "command_count":         { "type": "long" },
                      "unique_commands":       { "type": "long" },
                      "login_success_count":   { "type": "long" },
                      "login_fail_count":      { "type": "long" },
                      "file_download_count":   { "type": "long" },
                      "file_upload_count":     { "type": "long" },
                      "dominant_intent":       { "type": "keyword" },
                      "intent_distribution": {
                        "properties": {
                          "intent": {
                            "type": "text",
                            "fields": {
                              "keyword": { "type": "keyword", "ignore_above": 256 }
                            }
                          },
                          "count":  { "type": "long" }
                        }
                      },
                      "mean_novelty_score":    { "type": "float" },
                      "max_novelty_score":     { "type": "float" },
                      "mean_confidence":       { "type": "float" },
                      "command_entropy":       { "type": "float" },
                      "session_embed_version": { "type": "keyword" },
                      "playbook_id":           { "type": "keyword" },
                      "playbook_name":         { "type": "keyword" },
                      "credentials": {
                        "type": "text",
                        "fields": {
                          "keyword": { "type": "keyword", "ignore_above": 256 }
                        }
                      },
                      "command_signature": {
                        "type": "text",
                        "fields": {
                          "keyword": { "type": "keyword", "ignore_above": 64 }
                        }
                      },
                      "command_set": {
                        "type": "text",
                        "fields": {
                          "keyword": { "type": "keyword", "ignore_above": 32 }
                        }
                      },
                      "command_bigram_signature": {
                        "type": "text",
                        "fields": {
                          "keyword": { "type": "keyword", "ignore_above": 64 }
                        }
                      },
                      "command_bigram_set": {
                        "type": "text",
                        "fields": {
                          "keyword": { "type": "keyword", "ignore_above": 64 }
                        }
                      },
                      "artifact_set": {
                        "type": "text",
                        "fields": {
                          "keyword": { "type": "keyword", "ignore_above": 512 }
                        }
                      },
                      "file_events": {
                        "type": "nested",
                        "properties": {
                          "action":   { "type": "keyword" },
                          "sha256":   { "type": "keyword" },
                          "filename": {
                            "type": "text",
                            "fields": { "keyword": { "type": "keyword", "ignore_above": 512 } }
                          },
                          "url": {
                            "type": "text",
                            "fields": { "keyword": { "type": "keyword", "ignore_above": 1024 } }
                          },
                          "ts":                  { "type": "date" },
                          "command_hash":        { "type": "keyword" },
                          "command_attribution": { "type": "keyword" }
                        }
                      },
                      "embedding": {
                        "type": "dense_vector",
                        "dims": 768,
                        "index": true,
                        "similarity": "cosine"
                      },
                      "cluster": {
                        "properties": {
                          "id":            { "type": "keyword" },
                          "novelty_score": { "type": "float" },
                          "is_outlier":    { "type": "boolean" },
                          "scored_at":     { "type": "date" }
                        }
                      },
                      "source_ip_intel": {
                        "properties": {
                          "consensus_malicious":      { "type": "boolean" },
                          "consensus_label":          { "type": "keyword" },
                          "override_applied":         { "type": "keyword" },
                          "external_rarity_score":    { "type": "float" },
                          "malicious_provider_count": { "type": "integer" },
                          "clean_provider_count":     { "type": "integer" },
                          "confidence_max":           { "type": "integer" }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
