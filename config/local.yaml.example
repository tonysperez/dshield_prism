# ============================================================================
# Per-deploy overrides. Copy to config/local.yaml (or local.yml) and edit.
# DO NOT COMMIT config/local.yaml.
#
# Final config = default.yaml deep-merged with local.yaml. Any key set here
# overrides the same key in default.yaml; omit anything you don't override.
#
# This file lists EVERY tunable at its current effective default, commented
# out. To override one: uncomment the key (and its parent keys) and change the
# value. Leave the rest commented.
#
#   IMPORTANT: don't uncomment the whole file. A key pinned in local.yaml stops
#   tracking future default.yaml changes — override the minimum you need.
#
# Deploy essentials most installs set: elasticsearch.hosts, llm.base_url
# (REQUIRED) + llm models, worker.state_db. SECRETS — ES creds,
# ANTHROPIC_API_KEY, GREYNOISE/ABUSEIPDB/ABUSE_CH/VIRUSTOTAL keys — go in .env,
# never here.
# ============================================================================


# ===== elasticsearch =====
# ES connection + per-source index names. `hosts` is the deploy essential; creds live in .env.
# elasticsearch:
#   hosts:   # <-- REQUIRED per deploy
#   - https://localhost:9200
#   verify_certs: false
#   ca_certs: null
#   request_timeout: 60
#   indexes:
#     cowrie:
#       sessions_raw: prism.raw.cowrie.session
#       commands: prism.enriched.cowrie.command
#       command_clusters: prism.cluster.cowrie.command
#       sessions_rollup: prism.rollup.cowrie.session
#       session_clusters: prism.cluster.cowrie.session
#       ips_rollup: prism.rollup.cowrie.ip
#       ip_clusters: prism.cluster.cowrie.ip
#       campaigns: prism.campaign.cowrie
#       playbook_anchors: prism.identity.cowrie.playbook_anchor
#       operations: prism.operations
#       file_command_crossref: prism.crossref.file_command
#       reference_sessions: prism.reference.cowrie.session
#     dshield:
#       firewall: prism.raw.dshield.firewall
#       firewall_ip: prism.rollup.dshield.firewall_ip

# ===== llm =====
# Local LLM (enrichment + embeddings). provider/base_url/models are deploy-specific — base_url is REQUIRED.
# llm:
#   provider: ollama
#   base_url: null   # <-- REQUIRED per deploy (Ollama http://host:11434 | LM Studio http://host:1234)
#   generation_model: qwen/qwen3.5-9b   # <-- must match a model loaded on your LLM server
#   embedding_model: text-embedding-nomic-embed-text-v1.5@q8_0   # <-- must match an embedding model on your LLM server
#   request_timeout: 600
#   max_retries: 2
#   api_key: null
#   embed_context:
#   - intent
#   - tactics
#   - techniques
#   - description
#   embed_input_order: prelude_first

# ===== worker =====
# Worker runtime: state-DB path, logging, cache auto-invalidation.
# worker:
#   state_db: /var/lib/dshield_prism/state.sqlite   # <-- writable path for the SQLite state DB
#   page_size: 1000
#   command_max_chars: 4000
#   initial_lookback_days: null
#   log_level: INFO
#   log_dir: /var/log/dshield_prism
#   cache_auto_invalidate: true
#   cluster_n_jobs: -1

# ===== prompts =====
# Prompt file paths (resolved from the process working directory).
# prompts:
#   command_enrichment: config/prompts/command_enrichment.txt
#   command_deep_dive: config/prompts/command_deep_dive.txt
#   playbook_name: config/prompts/playbook_name.txt
#   playbook_disambiguate: config/prompts/playbook_disambiguate.txt
#   cluster_pair_explanation: config/prompts/cluster_pair_explanation.txt

# ===== cloud =====
# Cloud (Claude) escalation for hard/novel/low-confidence commands. Off by default; needs ANTHROPIC_API_KEY in .env.
# cloud:
#   enabled: false
#   provider: anthropic
#   base_url: null
#   model: claude-sonnet-4-6
#   max_tokens: 1024
#   request_timeout: 120
#   daily_budget_usd: 5.0
#   writeup_daily_budget_usd: 0.0
#   rpm_limit: 10
#   triage:
#     confidence_max: 4
#     escalate_confidence_max: 8
#     sample_rate: 0.01
#     base64_min_run: 200
#     suspicious_tlds:
#     - xyz
#     - top
#     - tk
#     - ml
#     - ga
#     - cf
#     - gq
#     - club
#     - icu
#     - buzz
#     - monster
#     - rest
#     - bar
#     - fit
#     - online
#     - site
#     - stream
#     - cam
#     novel_embedding_threshold: 0.5
#     novel_confidence_min: 4
#     intel_aware: true
#   pricing:
#     input_per_mtok: 3.0
#     output_per_mtok: 15.0

# ===== classification =====
# Data-privacy gate. Fail-safe: data with no explicit `public` tag is treated confidential and never sent to cloud/CTI.
# classification:
#   unclassified_is_confidential: true

# ===== command_cluster =====
# HDBSCAN over command embeddings.
# command_cluster:
#   min_cluster_size: 5
#   min_samples: 2
#   page_size: 1000
#   batch_size: 200
#   scalar_weight: 0.05
#   rescue_threshold: 0.94
#   reference_max_age_days: 45
#   cluster_svd_dim: 128

# ===== session =====
# Session rollup + clustering + playbook naming.
# session:
#   embed_version: v1
#   cluster_min_cluster_size: 5
#   cluster_min_samples: 2
#   cluster_scalar_weight: 0.05
#   page_size: 2000
#   batch_size: 200
#   rollup_workers: 5
#   playbook_sample_commands: 15
#   playbook_naming_session_cap: 500
#   playbook_merge_distinctiveness_floor: 0.25
#   playbook_merge_threshold: 0.94
#   specificity_store_cap: 10000
#   specificity_threshold: 0.5
#   reference_max_age_days: 45
#   clustering_mode: hdbscan
#   fusion_max_docs: 15000
#   cluster_lexical_features_dim: 100
#   cluster_window_days: 30

# ===== ip =====
# IP rollup + clustering. Flip `full_recluster_weekly: true` before pooling the multi-sensor backlog.
# ip:
#   embed_version: v1
#   cluster_min_cluster_size: 3
#   cluster_min_samples: 2
#   cluster_scalar_weight: 0.05
#   cluster_attribution_weight: 0.1
#   attribution_top_asns: 50
#   attribution_cred_hash_dim: 16
#   cluster_hassh_weight: 0.05
#   cluster_attribution_provenance_enabled: false
#   cluster_tier1_enabled: true
#   cluster_tier2_enabled: true
#   cluster_tier2_svd_dim: 24
#   attribution_hassh_hash_dim: 8
#   page_size: 2000
#   batch_size: 1000
#   rollup_workers: 5
#   reference_max_age_days: 45
#   full_recluster_weekly: false

# ===== cooccurrence =====
# Per-command session co-occurrence context for enrichment/embedding.
# cooccurrence:
#   enabled: true
#   session_sample_size: 50
#   top_k: 8
#   min_sessions: 3
#   embed_cooccurrence: false

