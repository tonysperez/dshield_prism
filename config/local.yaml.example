# ===== command_shape_dedup =====
# Functional-duplicate gating: inherit enrichment across same-shape commands instead of re-calling the LLM.
# command_shape_dedup:
#   enabled: true
#   min_parent_confidence: 5
#   require_known_intent: true

# ===== analyst =====
# Analyst-authored artifact-extraction rules subsystem.
# analyst:
#   enabled: true
#   indexes:
