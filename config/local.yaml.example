#   scan_batch_size: 100
#   max_match_per_doc: 50
#   sync_scan_doc_threshold: 5000
#   regex_compile_timeout_ms: 50
#   regex_sample_size: 500
#   max_match_count_per_rule: 50000

# ===== metrics =====
# Per-run threshold-distribution snapshot writer.
# metrics:
#   enabled: false
#   indexes:
#     default: prism.metrics

# ===== ops =====
# Pipeline run-telemetry writer + console 'pipeline running' banner freshness window.
# ops:
#   indexes:
#     default: prism.ops
